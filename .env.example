OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_FALLBACK_MODELS=qwen2.5:7b-instruct,qwen3:14b
OLLAMA_TEMPERATURE=0
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_KEEP_ALIVE=15m

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=please-change-me
NEO4J_DATABASE=neo4j

CHUNK_MAX_CHARS=1800
CHUNK_OVERLAP_CHARS=150
LOG_LEVEL=DEBUG

# Semantic retrieval
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Ollama-served embedding model used only by evaluation/ragas_supplement.py.
RAGAS_EMBEDDING_MODEL=nomic-embed-text  # pull with: ollama pull nomic-embed-text — chat models don't serve /v1/embeddings
# Leave EMBEDDING_DEVICE empty to auto-select cuda when available, else cpu.
EMBEDDING_DEVICE=
EMBEDDING_BATCH_SIZE=32
VECTOR_INDEX_NAME=source_chunk_embedding
VECTOR_DIMENSIONS=768
VECTOR_SIMILARITY=cosine
SEMANTIC_TOP_K=10
SEMANTIC_RETRIEVAL_ENABLED=true

# Hybrid ranking weights (confirmed state): semantic vs. graph relevance.
# Graph-favored by default so structurally verified evidence leads.
HYBRID_SEMANTIC_WEIGHT=0.4
HYBRID_GRAPH_WEIGHT=0.6
